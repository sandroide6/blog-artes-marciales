---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import FilterBar from '../../components/FilterBar.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="es">
	<head>
		<BaseHead
			title={`Artículos & Guías Técnicas — ${SITE_TITLE}`}
			description="Explora todos los análisis técnicos, historia y filosofía sobre Karate, BJJ, Muay Thai, Boxeo y MMA."
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="blog-directory-header">
				<div class="header-pre">
					<span class="pre-badge">Biblioteca Marcial</span>
				</div>
				<h1 class="directory-title">Artículos & Guías Técnicas</h1>
				<p class="directory-lead">
					Explora nuestra colección multidisciplinaria de artículos clasificados por disciplina marcial, nivel de dificultad y enfoque técnico.
				</p>
			</header>

			<!-- Barra de Filtrado Reactiva Nativa (Vanilla JS) -->
			<FilterBar totalPosts={posts.length} />

			<!-- Grid de Artículos -->
			<div class="articles-grid" id="articles-container">
				{posts.map((post) => (
					<ArticleCard post={post} />
				))}
			</div>

			<!-- Estado Vacío cuando un filtro no arroja resultados -->
			<div id="filter-empty-state" class="empty-state" style="display: none;">
				<div class="empty-icon">🥋</div>
				<h3>No se encontraron artículos</h3>
				<p>No hay publicaciones disponibles para la disciplina seleccionada en este momento.</p>
				<button type="button" class="btn-reset" onclick="window.location.search = ''">
					Ver todos los artículos
				</button>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.blog-directory-header {
		text-align: center;
		max-width: 720px;
		margin: 0 auto 3rem;
		padding-top: 1rem;
	}

	.header-pre {
		margin-bottom: 0.75rem;
	}

	.pre-badge {
		display: inline-block;
		font-size: 0.75rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--accent-brand);
		background-color: var(--accent-brand-glow);
		padding: 0.25rem 0.75rem;
		border-radius: var(--radius-full);
		border: 1px solid rgba(225, 29, 72, 0.35);
	}

	.directory-title {
		font-size: clamp(2.2rem, 4vw, 3rem);
		margin-bottom: 1rem;
	}

	.directory-lead {
		font-size: 1.15rem;
		color: var(--text-secondary);
		line-height: 1.6;
		margin: 0;
	}

	.articles-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(330px, 1fr));
		gap: 2rem;
		margin-bottom: 4rem;
	}

	@media (max-width: 680px) {
		.articles-grid {
			grid-template-columns: 1fr;
		}
	}

	.empty-state {
		text-align: center;
		padding: 4rem 1.5rem;
		background: var(--bg-card);
		border: 1px dashed var(--border-medium);
		border-radius: var(--radius-lg);
		margin-bottom: 4rem;
	}

	.empty-icon {
		font-size: 3rem;
		margin-bottom: 1rem;
		opacity: 0.6;
	}

	.empty-state h3 {
		font-size: 1.4rem;
		margin-bottom: 0.5rem;
		color: var(--text-primary);
	}

	.empty-state p {
		color: var(--text-muted);
		margin-bottom: 1.5rem;
		max-width: 420px;
		margin-left: auto;
		margin-right: auto;
	}

	.btn-reset {
		background-color: var(--accent-brand);
		color: #ffffff;
		border: none;
		padding: 0.65rem 1.35rem;
		border-radius: var(--radius-md);
		font-weight: 600;
		font-size: 0.9rem;
		cursor: pointer;
		transition: background-color var(--transition-fast);
	}

	.btn-reset:hover {
		background-color: #f43f5e;
	}
</style>
