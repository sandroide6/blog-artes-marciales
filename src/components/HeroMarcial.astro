---
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import MartialBadge from './MartialBadge.astro';

export interface Props {
  title?: string;
  subtitle?: string;
  featuredPost?: CollectionEntry<'blog'>;
}

const {
  title = 'El Camino del Guerrero, del Tatami a la Jaula',
  subtitle = 'Análisis técnico exhaustivo, biomecánica de golpeo, estrategia posicional y la ética profunda del Budo tradicional adaptada al combate contemporáneo.',
  featuredPost,
} = Astro.props;
---

<header class="hero-marcial">
  <div class="hero-backdrop" aria-hidden="true"></div>

  <div class="hero-inner">
    <div class="hero-text-col">
      <div class="hero-badge-tag">
        <span class="live-dot" aria-hidden="true"></span>
        <span>Revista Técnica Marcial & Deportes de Combate</span>
      </div>

      <h1 class="hero-title">
        {title.split(',')[0]}
        {title.includes(',') && <span class="highlight">, {title.split(',').slice(1).join(',')}</span>}
      </h1>

      <p class="hero-lead">{subtitle}</p>

      <div class="hero-actions">
        <a href="/blog/" class="btn btn-primary">
          <span>Explorar Catálogo</span>
          <span aria-hidden="true">→</span>
        </a>
        <a href="/about/" class="btn btn-secondary">
          <span>Filosofía & Código Budo</span>
        </a>
      </div>

      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-number">5</span>
          <span class="stat-label">Disciplinas Canónicas</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-number">100%</span>
          <span class="stat-label">Rigor Biomecánico</span>
        </div>
        <div class="stat-divider" aria-hidden="true"></div>
        <div class="stat-item">
          <span class="stat-number">0 KB</span>
          <span class="stat-label">Frameworks Lentos</span>
        </div>
      </div>
    </div>

    {featuredPost && (
      <div class="hero-featured-col">
        <div class="featured-card-wrapper">
          <div class="featured-badge-top">
            <span>🔥 Artículo Destacado</span>
          </div>

          <a href={`/blog/${featuredPost.id}/`} class="featured-card">
            <div class="featured-img-box">
              {featuredPost.data.heroImage ? (
                <Image
                  src={featuredPost.data.heroImage}
                  alt={featuredPost.data.title}
                  width={640}
                  height={360}
                  class="featured-img"
                />
              ) : (
                <div class="featured-fallback-img">🥋</div>
              )}
              <div class="featured-discipline-tag">
                <MartialBadge disciplina={featuredPost.data.disciplina} size="sm" />
              </div>
            </div>

            <div class="featured-body">
              <div class="featured-meta">
                <span>⏱️ {featuredPost.data.readingTime} de lectura</span>
                <span>•</span>
                <span>Por {featuredPost.data.autor.name}</span>
              </div>
              <h2 class="featured-title">{featuredPost.data.title}</h2>
              <p class="featured-desc">{featuredPost.data.description}</p>
              <div class="featured-link">
                <span>Leer guía completa</span>
                <span aria-hidden="true">→</span>
              </div>
            </div>
          </a>
        </div>
      </div>
    )}
  </div>
</header>

<style>
  .hero-marcial {
    position: relative;
    padding: 3rem 0 4rem;
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 3rem;
  }

  .hero-backdrop {
    position: absolute;
    top: -20%;
    left: 50%;
    transform: translateX(-50%);
    width: 100vw;
    height: 100%;
    background: radial-gradient(ellipse at 50% 20%, rgba(225, 29, 72, 0.12) 0%, rgba(11, 13, 16, 0) 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.15fr 0.95fr;
    gap: 3.5rem;
    align-items: center;
  }

  @media (max-width: 960px) {
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }

  .hero-badge-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-brand);
    background-color: var(--accent-brand-glow);
    padding: 0.35rem 0.85rem;
    border-radius: var(--radius-full);
    border: 1px solid rgba(225, 29, 72, 0.35);
    margin-bottom: 1.25rem;
  }

  .live-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #ef4444;
    box-shadow: 0 0 8px #ef4444;
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    font-size: clamp(2.2rem, 4.5vw, 3.4rem);
    line-height: 1.12;
    margin: 0 0 1.25rem;
  }

  .highlight {
    background: linear-gradient(135deg, #f87171, #fb7185, #fda4af);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-lead {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin: 0 0 2rem;
    max-width: 580px;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.8rem 1.4rem;
    border-radius: var(--radius-md);
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    transition: all var(--transition-fast);
  }

  .btn-primary {
    background-color: var(--accent-brand);
    color: #ffffff;
    box-shadow: 0 4px 15px rgba(225, 29, 72, 0.4);
  }

  .btn-primary:hover {
    background-color: #f43f5e;
    color: #ffffff;
    box-shadow: 0 6px 20px rgba(225, 29, 72, 0.55);
    transform: translateY(-2px);
  }

  .btn-secondary {
    background-color: var(--bg-card);
    color: var(--text-primary);
    border: 1px solid var(--border-medium);
  }

  .btn-secondary:hover {
    background-color: var(--bg-card-hover);
    border-color: var(--text-muted);
    transform: translateY(-2px);
  }

  .hero-stats {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .stat-item {
    display: flex;
    flex-direction: column;
  }

  .stat-number {
    font-size: 1.45rem;
    font-weight: 800;
    color: var(--text-primary);
    line-height: 1;
  }

  .stat-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 0.25rem;
  }

  .stat-divider {
    width: 1px;
    height: 28px;
    background-color: var(--border-subtle);
  }

  /* Featured Card en Hero */
  .featured-card-wrapper {
    position: relative;
  }

  .featured-badge-top {
    position: absolute;
    top: -12px;
    right: 20px;
    background: #e11d48;
    color: white;
    font-size: 0.725rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 0.25rem 0.75rem;
    border-radius: var(--radius-full);
    z-index: 3;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }

  .featured-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border-medium);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    transition: transform var(--transition-base), border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: var(--accent-brand);
    box-shadow: var(--shadow-card), 0 0 20px -5px rgba(225, 29, 72, 0.35);
  }

  .featured-img-box {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--bg-secondary);
  }

  .featured-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-card:hover .featured-img {
    transform: scale(1.05);
  }

  .featured-discipline-tag {
    position: absolute;
    bottom: 0.85rem;
    left: 0.85rem;
    z-index: 2;
  }

  .featured-body {
    padding: 1.5rem;
  }

  .featured-meta {
    display: flex;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-muted);
    margin-bottom: 0.65rem;
  }

  .featured-title {
    font-size: 1.35rem;
    line-height: 1.3;
    margin: 0 0 0.65rem;
    color: var(--text-primary);
  }

  .featured-desc {
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 1.25rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .featured-link {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--accent-brand);
  }

  .featured-card:hover .featured-link {
    color: #fda4af;
  }
</style>
