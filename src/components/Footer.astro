---
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { DISCIPLINES_LIST } from '../data/disciplines';

const today = new Date();
---

<footer class="martial-footer">
	<div class="footer-inner">
		<div class="footer-top">
			<div class="footer-brand-col">
				<div class="footer-logo">
					<span class="footer-emblem">🥋</span>
					<span class="footer-title">{SITE_TITLE}</span>
				</div>
				<p class="footer-desc">{SITE_DESCRIPTION}</p>
				<div class="footer-quote">
					<span class="quote-kanji">武道</span>
					<span class="quote-text">"El propósito del Budo es pulir la mente y el carácter, no derrotar al rival."</span>
				</div>
			</div>

			<div class="footer-links-col">
				<h4 class="col-title">Disciplinas</h4>
				<ul class="col-list">
					{DISCIPLINES_LIST.map((disc) => (
						<li>
							<a href={`/artes/${disc.id}/`}>
								<span class="disc-bullet" style={`background-color: ${disc.accentColor};`}></span>
								<span>{disc.name}</span>
							</a>
						</li>
					))}
				</ul>
			</div>

			<div class="footer-links-col">
				<h4 class="col-title">Exploración</h4>
				<ul class="col-list">
					<li><a href="/">Inicio</a></li>
					<li><a href="/blog/">Todos los Artículos</a></li>
					<li><a href="/about/">Filosofía & Budo</a></li>
					<li><a href="/rss.xml">Feed RSS</a></li>
				</ul>
			</div>
		</div>

		<div class="footer-bottom">
			<p class="copyright">
				&copy; {today.getFullYear()} {SITE_TITLE}. Desarrollado con <strong>Astro</strong> & estándar Web nativo.
			</p>
			<p class="disclaimer">
				Las artes marciales conllevan riesgo físico. Entrena siempre bajo la supervisión de un instructor calificado y en condiciones de seguridad adecuadas.
			</p>
		</div>
	</div>
</footer>

<style>
	.martial-footer {
		background-color: var(--bg-secondary);
		border-top: 1px solid var(--border-subtle);
		padding: 4rem 1.25rem 2.5rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.footer-inner {
		max-width: var(--container-width);
		margin: 0 auto;
	}

	.footer-top {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 3rem;
		margin-bottom: 3rem;
	}

	@media (max-width: 860px) {
		.footer-top {
			grid-template-columns: 1fr;
			gap: 2rem;
		}
	}

	.footer-logo {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		margin-bottom: 0.85rem;
	}

	.footer-emblem {
		font-size: 1.5rem;
	}

	.footer-title {
		font-size: 1.25rem;
		font-weight: 800;
		color: var(--text-primary);
		letter-spacing: 0.04em;
	}

	.footer-desc {
		color: var(--text-secondary);
		font-size: 0.925rem;
		line-height: 1.6;
		margin-bottom: 1.25rem;
		max-width: 480px;
	}

	.footer-quote {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.75rem 1rem;
		background: var(--bg-card);
		border-radius: var(--radius-md);
		border-left: 3px solid var(--accent-brand);
		max-width: 480px;
	}

	.quote-kanji {
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--accent-brand);
	}

	.quote-text {
		font-size: 0.8rem;
		font-style: italic;
		color: var(--text-secondary);
	}

	.col-title {
		font-size: 0.85rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-primary);
		margin: 0 0 1.25rem;
	}

	.col-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.col-list a {
		color: var(--text-secondary);
		text-decoration: none;
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		transition: color var(--transition-fast), transform var(--transition-fast);
	}

	.col-list a:hover {
		color: #ffffff;
		transform: translateX(3px);
	}

	.disc-bullet {
		width: 6px;
		height: 6px;
		border-radius: 50%;
	}

	.footer-bottom {
		padding-top: 2rem;
		border-top: 1px solid var(--border-subtle);
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		text-align: center;
	}

	.copyright {
		margin: 0;
		color: var(--text-muted);
		font-size: 0.85rem;
	}

	.copyright strong {
		color: var(--text-primary);
	}

	.disclaimer {
		margin: 0;
		font-size: 0.75rem;
		color: var(--text-dim);
	}
</style>
